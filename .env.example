# ============================================================================
# ODS (Olar Design Studio) — Google Drive Portfolio Synchronization Config
# ============================================================================
# Keep these variables strictly on the server (.env). Never prefix secrets with VITE_.

# --- Option A: Service Account Authentication (Recommended for Production) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Or path to service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Option B: Restricted Google Drive API v3 Key (For Shared Studio Folders) ---
GOOGLE_DRIVE_API_KEY=""

# --- Google Drive Folder Organization ---
# Recommended structure inside Google Drive:
# ODS Portfolio (Root)
#   ├── Logo Branding
#   ├── Social Media Design
#   ├── Flyers
#   └── Cinematic Video Editing

# Root "ODS Portfolio" Folder ID (Automatically discovers the 4 category subfolders):
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Or explicit Folder IDs per category:
GOOGLE_DRIVE_FOLDER_LOGO_BRANDING=""
GOOGLE_DRIVE_FOLDER_SOCIAL_MEDIA=""
GOOGLE_DRIVE_FOLDER_FLYERS=""
GOOGLE_DRIVE_FOLDER_VIDEO_EDITING=""

# --- Synchronization & Webhook Security ---
# Scheduled sync interval in milliseconds (default: 300000 = 5 minutes)
PORTFOLIO_SYNC_INTERVAL_MS="300000"
# Optional secret token required for POST /api/portfolio/sync or Google Drive push webhooks
PORTFOLIO_SYNC_SECRET=""

